#tag WindowCode
	#tag Event
		Sub Opening()
		  // The sections and items come from the sidebar's InitialValue. Each entry's ID is its caption.
		  Navigation.SetBadge("Inbox", "5")
		  Navigation.SetBadge("Invitations", "2")
		  Navigation.SetItemEnabled("Billing", False)
		  Navigation.AddItem("Settings", "Settings", "settings", "", "", True)
		  Navigation.AddItem("Help & support", "Help & support", "help", "", "", True)
		  Navigation.SetItemCSSClasses("Inbox", "inbox-link")
		  Navigation.SetGroupExpanded("Team", True)
		  Var folderIcon As New Picture(32, 32)
		  folderIcon.Graphics.DrawingColor = &cAD792D
		  folderIcon.Graphics.FillRoundRectangle(2, 6, 13, 9, 3, 3)
		  folderIcon.Graphics.FillRoundRectangle(2, 10, 28, 17, 3, 3)
		  Navigation.SetItemPicture("Projects", folderIcon)
		  Navigation.SetItemURL("Help & support", "https://documentation.xojo.com/")
		  Navigation.SelectedItemID = "Overview"
		  
		End Sub
	#tag EndEvent


	#tag Property, Flags = &h21
		Private mInboxCount As Integer = 5
	#tag EndProperty


#tag EndWindowCode

#tag Events Navigation
	#tag Event
		Sub ItemPressed(itemID As String)
		  // The ID is the entry's caption, so it can be shown as is.
		  ContentTitle.Text = itemID
		  SelectionLabel.Text = "Current section: " + ContentTitle.Text
		  StatusLabel.Text = "Navigation is handled in Xojo. The sidebar keeps its own state and appearance."
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events ThemeButton
	#tag Event
		Sub Pressed()
		  Select Case Navigation.Theme
		  Case "light"
		    Navigation.Theme = "dark"
		  Case "dark"
		    Navigation.Theme = "auto"
		  Else
		    Navigation.Theme = "light"
		  End Select
		  StatusLabel.Text = "Sidebar theme: " + Navigation.Theme
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events BadgeButton
	#tag Event
		Sub Pressed()
		  mInboxCount = mInboxCount + 1
		  Navigation.SetBadge("Inbox", mInboxCount.ToString)
		  StatusLabel.Text = "Inbox badge updated from Xojo."
		End Sub
	#tag EndEvent
#tag EndEvents
